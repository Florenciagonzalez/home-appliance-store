            ]
          }
        }
      ]
    },
    {
      "name": "10 Verificar cantidades y total",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{shopcartUrl}}/api/shopcarts/{{cartId}}/products"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test('Una fila, cinco unidades y total 51.25', () => {",
              " const cart = pm.response.json();",
              " pm.expect(cart.items).to.have.lengthOf(1);",
              " pm.expect(cart.items[0].quantity).to.eql(5);",
              " pm.expect(cart.total_price).to.eql(51.25);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "11 Registrar venta",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{salesUrl}}/api/sales",
        "body": {
          "mode": "raw",
          "raw": "{\"shopcartId\": {{cartId}}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test('Total de venta correcto', () => pm.expect(pm.response.json().total_price).to.eql(51.25));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"saleId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
