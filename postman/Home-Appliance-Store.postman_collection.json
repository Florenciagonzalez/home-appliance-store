              " pm.expect(sale.items[0].unit_price).to.eql(10.25);",
              " pm.expect(sale.items[0].quantity).to.eql(5);",
              " pm.expect(sale.total_price).to.eql(51.25);",
              "});"
            ]
          }
        }
      ]
