      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));",
              "pm.test('Codigo de duplicado', () => pm.expect(pm.response.json().code).to.eql('CART_ALREADY_PURCHASED'));"
            ]
          }
        }
      ]
    },
