{
  "info": {
    "name": "Home Appliance Store - MVP",
    "description": "Ejecutar en orden con Collection Runner, una iteracion y sin paralelismo. Crea datos nuevos en cada ejecucion y conserva la venta historica. Elimina el producto y los carritos creados. No usar con datos de produccion. No comprueba concurrencia ni fallos de disponibilidad.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "productsUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "shopcartUrl",
      "value": "http://localhost:8083"
    },
    {
      "key": "salesUrl",
      "value": "http://localhost:8082"
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "cartId",
      "value": ""
    },
    {
      "key": "saleId",
      "value": ""
    },
    {
      "key": "emptyCartId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Crear producto",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{productsUrl}}/api/products",
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Producto prueba Postman\", \"brand\": \"Demo\", \"unit_price\": 10.25}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"productId\", pm.response.json().id_product);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Rechazar nombre vacio",
